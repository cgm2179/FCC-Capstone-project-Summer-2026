# RF Simulation Studio backend — optional API keys.
#
# NONE of these are required: the OSM / Carto basemap the app uses streams free tiles
# (no key). Copy this file to  Backend/server/.env  (which is git-ignored, so only you can
# edit it and it never lands in the repo) and fill a value in only if you opt into a premium
# provider. The server reads Backend/server/.env at startup if present.

# Premium basemap provider token (e.g. Mapbox) — optional, for higher-res satellite/street
# tiles under the outdoor views. Leave as-is to keep using the free OSM/Carto tiles.
MAPBOX_TOKEN=put api here for the api
